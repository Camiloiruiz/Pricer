# ── Source control ────────────────────────────────────────────────────────────
.git
.gitignore

# ── Node dependencies (rebuilt inside container) ──────────────────────────────
node_modules
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Next.js build artefacts ───────────────────────────────────────────────────
.next
out

# ── Environment files (injected at runtime, never baked into image) ───────────
.env
.env.local
.env.*.local
.env.development
.env.production

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode
.idea
*.suo
*.sw?
.DS_Store

# ── Playwright artefacts ──────────────────────────────────────────────────────
test-results/
playwright-report/

# ── Docker files themselves (no need to COPY into the image) ──────────────────
Dockerfile*
docker-compose*.yaml
.dockerignore

# ── Docs / CI ─────────────────────────────────────────────────────────────────
README.md
.github/

# ── Legacy Vite files (not used by Next.js) ───────────────────────────────────
vite.config.ts
index.html
index.tsx
App.tsx
geminiService.ts
metadata.json
types.ts
